# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
# Xcode does not necessarily inherit the terminal's Homebrew PATH.
if [ -x /opt/homebrew/opt/node@22/bin/node ]; then
  export NODE_BINARY=/opt/homebrew/opt/node@22/bin/node
elif [ -x /usr/local/opt/node@22/bin/node ]; then
  export NODE_BINARY=/usr/local/opt/node@22/bin/node
else
  export NODE_BINARY="$(command -v node)"
fi

# Xcode scheme builds must select the matching JS/country configuration too.
case "${TARGET_NAME:-}" in
  ParentBuddyApp) BEBBO_TARGET_FLAVOUR=bebbo ;;
  ParentBuddyAppDev) BEBBO_TARGET_FLAVOUR=bebboDev ;;
  ParentBuddyAppXk|ParentBuddyAppXkDev) BEBBO_TARGET_FLAVOUR=foleja ;;
  ParentBuddyAppBangla|ParentBuddyAppBanglaDev) BEBBO_TARGET_FLAVOUR=babuni ;;
  MerhabaBebek) BEBBO_TARGET_FLAVOUR=merhabaBebek ;;
  Wawamor) BEBBO_TARGET_FLAVOUR=wawamor ;;
  ReraiUmntwana) BEBBO_TARGET_FLAVOUR=reraiUmntwana ;;
  BebboPacific) BEBBO_TARGET_FLAVOUR=bebboPacific ;;
  *) BEBBO_TARGET_FLAVOUR= ;;
esac
if [ -n "$BEBBO_TARGET_FLAVOUR" ]; then
  if [ -n "${FLAVOR:-}" ] && [ "$FLAVOR" != "$BEBBO_TARGET_FLAVOUR" ]; then
    echo "error: TARGET_NAME=$TARGET_NAME requires FLAVOR=$BEBBO_TARGET_FLAVOUR" >&2
    exit 1
  fi
  export FLAVOR="$BEBBO_TARGET_FLAVOUR"
  export ENVFILE="${ENVFILE:-$SRCROOT/../env/.env.$FLAVOR}"
fi
# Retain the composed Hermes source map privately alongside build intermediates.
# The map may contain environment values; never put it in a public artifact/log.
if [ "${CONFIGURATION:-}" = "Release" ] && [ -n "${DERIVED_FILE_DIR:-}" ]; then
  export SOURCEMAP_FILE="${SOURCEMAP_FILE:-$DERIVED_FILE_DIR/$TARGET_NAME-$CONFIGURATION.js.map}"
  mkdir -p "$(dirname "$SOURCEMAP_FILE")"
fi
