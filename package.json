  "codegenConfig": {
    "name": "BebboDriveAuthorizationSpec",
    "type": "modules",
    "jsSrcsDir": "app/specs",
    "android": {
      "javaPackageName": "org.unicef.ecar.bebbo"
    },
    "ios": {
      "modulesProvider": {
        "LegacyNotifications": "LegacyNotifications"
      }
    }
  },
